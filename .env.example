# pi-ai uses each provider's standard environment variable. Models stay
# disabled in the UI until their provider has a server or browser-session key.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional. Must be one of the model IDs shown in README.md.
CHAT_DEFAULT_MODEL=deepseek/deepseek-v4-flash
