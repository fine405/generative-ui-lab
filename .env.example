# When true, chat uses the server-side API key by default.
# Keep false on a public deployment unless access is otherwise protected.
CHAT_ENABLED=false

# Server-only. Never prefix this variable with NEXT_PUBLIC_.
CHAT_API_KEY=

# Any OpenAI-compatible provider can be used. These defaults target DeepSeek.
CHAT_PROVIDER=deepseek
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash
